{
  "name": "@gms/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "indexes": "node --env-file-if-exists=.env scripts/indexes.js",
    "backup": "node --env-file-if-exists=.env scripts/backupJob.js --backup",
    "restore": "node --env-file-if-exists=.env scripts/backupJob.js --restore",
    "backup:verify": "node --env-file-if-exists=.env scripts/backupJob.js --verify",
    "backup:schedule": "node --env-file-if-exists=.env scripts/backupJob.js --schedule"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3"
  }
}
