NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/gms
# Generate two different secrets, each at least 32 characters, before starting.
JWT_SECRET=
PASS_SECRET=
# Production behind one trusted TLS-terminating reverse proxy only:
# NODE_ENV=production
# TRUST_PROXY=1
# PUBLIC_ORIGIN=https://gym.example.com
# Use an external MongoDB for local development, or opt into an ephemeral demo:
# DEMO_DATABASE=true
# DEMO_PASSWORD=choose-a-local-demo-password
