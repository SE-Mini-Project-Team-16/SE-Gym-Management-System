# Adapt hostname/certificate paths, then validate the configuration before deployment.
server {
    listen 80;
    server_name gym.example.com;
    return 308 https://gym.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name gym.example.com;
    ssl_certificate /etc/letsencrypt/live/gym.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gym.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        # Overwrite rather than forward untrusted incoming headers.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
}
