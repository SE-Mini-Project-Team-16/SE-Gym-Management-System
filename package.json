{
  "name": "se-gym-management-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "seed": "npm run seed -w server",
    "backup": "npm run backup -w server",
    "restore": "npm run restore -w server",
    "backup:verify": "npm run backup:verify -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:performance": "node server/scripts/benchmark.js"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
